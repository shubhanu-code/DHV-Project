# Leave blank for local development (Vite proxies /api to localhost:5000).
# For a deployed frontend, set this to the separately hosted API base, e.g. https://your-api.example.com/api.
VITE_API_BASE_URL=

# Chatbot FastAPI origin; leave blank to use Vite's /chat-api proxy to localhost:8000.
# For a deployed frontend, set this to the FastAPI origin (without /api); allow the frontend origin via CHATBOT_CORS_ORIGINS.
VITE_CHAT_API_BASE_URL=
